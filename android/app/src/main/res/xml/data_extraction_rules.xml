<?xml version="1.0" encoding="utf-8"?>
<!--
   Regras de extração de dados (Android 12+).
   A sessão autenticada do YouTube nunca deve ser copiada para a nuvem.
   Ver https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="youtube-auth/" />
    </cloud-backup>
</data-extraction-rules>
